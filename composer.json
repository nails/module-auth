{
    "name": "nails/module-auth",
    "keywords": [
        "Nails",
        "Shed Collective",
        "CodeIgniter",
        "Auth Module"
    ],
    "homepage": "http://nailsapp.co.uk/modules/auth",
    "description": "This is the \"Auth\" module for Nails.",
    "license": "MIT",
    "authors": [
        {
            "name": "Pablo de la Pena",
            "email": "p@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        },
        {
            "name": "Gary Duncan",
            "email": "g@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hello@nailsapp.co.uk"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/common": "dev-feature/pre-new-admin",
        "nails/module-admin": "dev-feature/pre-new-admin",
        "nails/module-api": "dev-feature/pre-new-admin",
        "nails/module-captcha": "dev-feature/pre-new-admin",
        "nails/module-console": "dev-feature/pre-new-admin",
        "nails/module-cron": "dev-feature/pre-new-admin",
        "nails/module-email": "dev-feature/pre-new-admin",
        "nails/module-form-builder": "dev-feature/pre-new-admin",
        "sonata-project/google-authenticator": "~2.3.0",
        "wikimedia/common-passwords": "^v0.4",
        "lbuchs/webauthn": "^2.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "nails/module-queue": "dev-feature/pre-new-admin"
    },
    "suggest": {
        "nails/module-queue": "Processes user imports on a long-running worker, rather than in chunks on the cron.",
        "ext-sodium": "Allows passkeys which use Ed25519 (EdDSA) keys to be registered and verified."
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon --memory-limit=1G",
        "check-migrations": "php vendor/nails/common/scripts/check-migration-numbering.php"
    },
    "autoload": {
        "psr-4": {
            "Nails\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Auth\\": "tests/"
        }
    },
    "extra": {
        "nails": {
            "moduleName": "auth",
            "migrations": {
                "grandfathered": {
                    "16": "differs",
                    "17": "differs",
                    "18": "differs",
                    "19": "absent",
                    "20": "differs"
                }
            },
            "type": "module",
            "namespace": "Nails\\Auth\\",
            "autoload": {
                "models": [
                    "User",
                    "UserGroup",
                    "UserPassword"
                ],
                "helpers": [
                    "authUrls",
                    "passkey",
                    "user"
                ]
            },
            "data": {
                "nails/module-admin": {
                    "autoload": {
                        "assets": {
                            "css": [
                                "admin.min.css"
                            ],
                            "js": [
                                "admin.min.js"
                            ]
                        }
                    }
                },
                "nails/module-api": {
                    "namespace": "auth"
                },
                "nails/module-cdn": {
                    "permitted-image-dimensions": [
                        "35x35",
                        "50x50",
                        "65x65",
                        "100x100",
                        "100x125"
                    ]
                }
            }
        }
    }
}
